# ---------- Google Sheet (required) ----------
# Path to the service-account key you downloaded (keep it inside secrets/)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
# The long ID in your sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# ---------- LinkedIn burner (required) ----------
# Value of the li_at cookie from the burner's Chrome profile
LINKEDIN_LI_AT=

# ---------- Gemini (required for unclear-JD check) ----------
GEMINI_API_KEY=

# ---------- Gmail alerts (required) ----------
GMAIL_ADDRESS=
# 16-character app password, NOT your normal password (spaces are fine)
GMAIL_APP_PASSWORD=
# Where alerts go; leave blank to send to GMAIL_ADDRESS
ALERT_TO=

# ---------- Optional logins ----------
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
INSTAHYRE_EMAIL=
INSTAHYRE_PASSWORD=

# ---------- Settings ----------
# 0 = keep only jobs whose minimum is 0 yrs or unstated; 1 = also keep "1+ years"
MAX_MIN_YEARS=0
